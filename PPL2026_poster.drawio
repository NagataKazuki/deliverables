y: &amp;quot;Cambria Math&amp;quot;; line-height: 100%;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;   &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;text-indent: 0in; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-size: 36pt; font-family: &amp;quot;Cambria Math&amp;quot;; line-height: 100%;&quot;&gt;get(s′)↓v⇒put(s,v)↓s′&lt;/span&gt;&lt;font style=&quot;text-indent: 0in; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;span style=&quot;font-family: &amp;quot;Cambria Math&amp;quot;;&quot;&gt;(GetPut)&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-family: 游ゴシック;&quot;&gt;:&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;text-indent: 0in; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-size: 36pt; font-family: &amp;quot;Cambria Math&amp;quot;; line-height: 100%;&quot;&gt;∀s&lt;/span&gt;&lt;span style=&quot;text-indent: 0in; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-size: 36pt; font-family: &amp;quot;Cambria Math&amp;quot;; line-height: 100%;&quot;&gt;∈S&lt;/span&gt;&lt;span style=&quot;text-indent: 0in; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-size: 36pt; font-family: &amp;quot;Cambria Math&amp;quot;; line-height: 100%;&quot;&gt;,&lt;/span&gt;&lt;span style=&quot;text-indent: 0in; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-size: 36pt; font-family: &amp;quot;Cambria Math&amp;quot;; line-height: 100%;&quot;&gt;∀v∈V.&lt;/span&gt;&lt;span style=&quot;text-indent: 0in; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-size: 36pt; font-family: &amp;quot;Cambria Math&amp;quot;; line-height: 100%;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;   &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;text-indent: 0in; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-size: 36pt; font-family: &amp;quot;Cambria Math&amp;quot;; line-height: 100%;&quot;&gt;get(s)↓v⇒put(s,v)↓&lt;/span&gt;&lt;span style=&quot;text-indent: 0in; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-size: 36pt; font-family: &amp;quot;Cambria Math&amp;quot;; line-height: 100%;&quot;&gt;s&lt;/span&gt;&lt;/p&gt;&lt;div&gt;&lt;span style=&quot;font-family: &amp;quot;Cambria Math&amp;quot;;&quot;&gt;(Put&lt;/span&gt;&lt;span style=&quot;font-family: &amp;quot;Cambria Math&amp;quot;;&quot;&gt;Get)&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-family: 游ゴシック;&quot;&gt;:&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); text-indent: 0in; background-color: transparent; font-family: &amp;quot;Cambria Math&amp;quot;; font-size: 36pt; line-height: 48px;&quot;&gt;∀s,s′∈S,∀v∈V.&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;   &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); text-indent: 0in; background-color: transparent; font-size: 36pt; font-family: &amp;quot;Cambria Math&amp;quot;; line-height: 48px;&quot;&gt;put(s,v)↓s′⇒get(s′)↓v&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-family: &amp;quot;Cambria Math&amp;quot;;&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;font-family: &amp;quot;Cambria Math&amp;quot;;&quot;&gt;Pu&lt;/span&gt;&lt;span style=&quot;font-family: &amp;quot;Cambria Math&amp;quot;;&quot;&gt;tPut)&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-family: 游ゴシック;&quot;&gt;:&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); text-indent: 0in; background-color: transparent; font-family: &amp;quot;Cambria Math&amp;quot;;&quot;&gt;∀s,&lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); text-indent: 0in; background-color: transparent; font-family: &amp;quot;Cambria Math&amp;quot;;&quot;&gt;s′,s′′∈S,&lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); text-indent: 0in; background-color: transparent; font-family: &amp;quot;Cambria Math&amp;quot;;&quot;&gt;∀v,v′∈V.&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); text-indent: 0in; font-family: &amp;quot;Cambria Math&amp;quot;;&quot;&gt;p&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); text-indent: 0in; font-family: &amp;quot;Cambria Math&amp;quot;;&quot;&gt;ut(s,v)↓s′&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-family: &amp;quot;Cambria Math&amp;quot;;&quot;&gt;∧&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-family: &amp;quot;Cambria Math&amp;quot;;&quot;&gt;put(s′,v′)↓s&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-family: &amp;quot;Cambria Math&amp;quot;;&quot;&gt;′′⇒put(s,v′)↓s′′&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
