        <mxCell id="LXy5PpxRIBaws1J94ujE-12" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=50;" value="&lt;p style=&quot;line-height: 90%; margin-top: 10pt; margin-bottom: 0pt; margin-left: 0in; text-indent: 0in; direction: ltr; unicode-bidi: embed; word-break: normal;&quot;&gt;&lt;font data-font-src=&quot;https://fonts.googleapis.com/css?family=Cambria+Math&quot; face=&quot;Cambria Math&quot;&gt;&lt;span style=&quot;font-family: &amp;quot;Zen Kaku Gothic New&amp;quot;;&quot;&gt;レンズ則の含意関係が成り立たないことは次のように言い換えられる&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;line-height: 90%; margin-top: 10pt; margin-bottom: 0pt; margin-left: 0in; text-indent: 0in; direction: ltr; unicode-bidi: embed; word-break: normal;&quot;&gt;&lt;font data-font-src=&quot;https://fonts.googleapis.com/css?family=Cambria+Math&quot; face=&quot;Cambria Math&quot;&gt;&lt;font style=&quot;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;(GetPut)∧(PutGet)&lt;/font&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;⇏&lt;/span&gt;&lt;span style=&quot;text-indent: 0in; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;(PutPut)&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;margin-top: 0pt; margin-bottom: 0pt; margin-left: 0in; direction: ltr; unicode-bidi: embed; word-break: normal;&quot;&gt;&lt;font data-font-src=&quot;https://fonts.googleapis.com/css?family=Cambria+Math&quot; face=&quot;Cambria Math&quot;&gt;≡&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;¬(∀S,V,l. (GetPut)(S,V,l)&amp;nbsp;∧&amp;nbsp;(PutGet)(S,V,l)&amp;nbsp;&lt;/font&gt;&lt;span style=&quot;font-family: &amp;quot;Cambria Math&amp;quot;; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;⇒&lt;/span&gt;&lt;span style=&quot;font-family: &amp;quot;Cambria Math&amp;quot;; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp;(PutPut)(S,V,l)))&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin-top: 0pt; margin-bottom: 0pt; margin-left: 0in; direction: ltr; unicode-bidi: embed; word-break: normal;&quot;&gt;&lt;font data-font-src=&quot;https://fonts.googleapis.com/css?family=Cambria+Math&quot; face=&quot;Cambria Math&quot;&gt;≡&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;∃S,V,l. (GetPut)(S,V,l) ∧ (PutGet)(S,V,l) ∧ ¬(PutPut)(S,V,l)&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;margin-top: 0pt; margin-bottom: 0pt; margin-left: 0in; direction: ltr; unicode-bidi: embed; word-break: normal;&quot;&gt;&lt;font data-font-src=&quot;https://fonts.googleapis.com/css?family=Cambria+Math&quot; face=&quot;Cambria Math&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;line-height: 90%; margin-top: 10pt; margin-bottom: 0pt; margin-left: 0in; text-indent: 0in; direction: ltr; unicode-bidi: embed; word-break: normal;&quot;&gt;&lt;font data-font-src=&quot;https://fonts.googleapis.com/css?family=Cambria+Math&quot; face=&quot;Cambria Math&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;line-height: 90%; margin-top: 10pt; margin-bottom: 0pt; margin-left: 0in; text-indent: 0in; direction: ltr; unicode-bidi: embed; word-break: normal;&quot;&gt;&lt;span style=&quot;background-color: transparent; text-wrap-mode: nowrap; color: rgba(0, 0, 0, 0); font-size: 0px;&quot;&gt;&lt;font data-font-src=&quot;https://fonts.googleapis.com/css?family=Cambria+Math&quot; face=&quot;Cambria Math&quot;&gt;%20id%3D%220%22%2F%3E%3CmxCell%20id%3D%221%22%20parent%3D%220%22%2F%3E%3CmxCell%20id%3D%222%22%20value%3D%22%26lt%3Bp%20style%3D%26quot%3Bline-height%3A%2090%25%3B%20margin-top%3A%2010pt%3B%20margin-bottom%3A%200pt%3B%20margin-left%3A%200in%3B%20text-indent%3A%200in%3B%20direction%3A%20ltr%3B%20unicode-bidi%3A%20embed%3B%20word-break%3A%20normal%3B%26quot%3B%26gt%3B%26lt%3Bfont%26gt%3B%26lt%3Bfont%20data-font-src%3D%