        </mxCell>
        <mxCell id="B8QQFRzXlDioX6YQd4wl-35" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=50;" value="&lt;div style=&quot;line-height: 100%;&quot;&gt;&lt;div style=&quot;margin-top: 10pt; margin-bottom: 0pt; margin-left: 0.25in; text-indent: -0.25in; direction: ltr; unicode-bidi: embed; word-break: normal;&quot;&gt;&lt;h3 data-start=&quot;93&quot; data-end=&quot;149&quot;&gt;&lt;font face=&quot;Zen Kaku Gothic New&quot; style=&quot;font-size: 50px;&quot;&gt;全16個のレンズ則間の含意関係の証明の形式化&lt;/font&gt;&lt;/h3&gt;&lt;div&gt;&lt;font face=&quot;Zen Kaku Gothic New&quot;&gt;現状では、一部のレンズ則の含意関係のみ検証を行っている&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Zen Kaku Gothic New&quot;&gt;今後は、16個すべてのレンズ則について、&lt;/font&gt;&lt;font face=&quot;Caribian Math&quot;&gt;get&lt;/font&gt;&lt;font face=&quot;Zen Kaku Gothic New&quot;&gt; と&lt;/font&gt;&lt;font face=&quot;Caribian Math&quot;&gt; put&lt;/font&gt;&lt;font face=&quot;Zen Kaku Gothic New&quot;&gt; が&lt;span data-start=&quot;295&quot; data-end=&quot;313&quot;&gt;全域関数および&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Zen Kaku Gothic New&quot;&gt;&lt;span data-start=&quot;295&quot; data-end=&quot;313&quot;&gt;部分関数の場合&lt;/span&gt;の含意関係をRocq上で体系的に形式化する&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
