Ltac unfold_laws :=
  rewrite /SGP /GP /PG /PP /WPG /PGP 
          /UD /PT /SS /PS 
          /VD /PI /GS /GI /GPG.

Lemma non_implication (P Q : Prop) : P -> ~ Q -> ~ (P -> Q).
Proof. firstorder. Qed.

Ltac intro_all :=
  repeat (move=> ?).

Ltac ce_lens S V p_get p_put :=
  move=> H;
  have := H S V (mkLens p_get p_put);
  unfold_laws=> /=;
  intro_all.


